# Copy this file to .env (already gitignored) and fill in your own key.
# PROVIDER selects the base URL in backend/app/agents/config.py's
# _PROVIDER_BASE_URLS — currently one of: openai, openrouter, moonshot.

MODEL=kimi-k2.7-code
PROVIDER=moonshot
API_KEY=

# Optional: cap on output tokens per call, reasoning included. Leave unset to use
# the provider's default; Kimi K2.6 needs more than its default on longer agents.
# MAX_COMPLETION_TOKENS=131072
